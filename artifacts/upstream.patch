+@dataclass
+class _EmptyOutputStopEvidence:
+    """Observe raw choice-zero evidence before stream buffering discards terminal chunks."""
+
+    saw_empty_text: bool = False
+    saw_stop: bool = False
+    saw_other_output_or_terminal: bool = False
+
+    def observe(self, chunk: ChatCompletionChunk) -> None:
+        if len(chunk.choices) > 1 or any(choice.index != 0 for choice in chunk.choices):
+            self.saw_other_output_or_terminal = True
+        choice = next((choice for choice in chunk.choices if choice.index == 0), None)
+        if choice is None:
+            return
+        if choice.finish_reason == "stop":
+            self.saw_stop = True
+        elif choice.finish_reason is not None:
+            self.saw_other_output_or_terminal = True
+        delta = choice.delta
+        if delta is not None:
+            self.saw_empty_text = self.saw_empty_text or delta.content == ""
+            self.saw_other_output_or_terminal = self.saw_other_output_or_terminal or (
+                bool(delta.content)
+                or delta.refusal is not None
+                or bool(delta.tool_calls)
+                or delta.function_call is not None
+                or getattr(delta, "audio", None) is not None
+            )
+
+    @property
+    def stop_reason(self) -> Literal["stop"] | None:
+        if self.saw_empty_text and self.saw_stop and not self.saw_other_output_or_terminal:
+            return "stop"
+        return None
+
