+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+from pydantic import BaseModel
+
+from agents import (
+    Agent,
+    GuardrailFunctionOutput,
+    InputGuardrail,
+    InputGuardrailTripwireTriggered,
+    OutputGuardrail,
+    RunConfig,
+    RunContextWrapper,
+    Runner,
+    UserError,
+)
+from agents.lifecycle import RunHooks
+from agents.testing import ModelStep, ScriptedModel
+
+from .test_responses import get_text_message
+from .testing_processor import fetch_ordered_spans
+from .utils.simple_session import SimpleListSession
+
+
+class Answer(BaseModel):
+    value: str
+
+
+class EndHooks(RunHooks):
+    def __init__(self) -> None:
+        self.outputs: list[Any] = []
+
+    async def on_agent_end(
+        self, context: RunContextWrapper[Any], agent: Agent[Any], output: Any
+    ) -> None:
+        self.outputs.append(output)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("structured", [False, True])
+async def test_terminal_empty_is_not_an_answer(streaming: bool, structured: bool) -> None:
+    model = ScriptedModel([ModelStep(output=[], empty_output_stop_reason="stop")])
+    output_checks: list[Any] = []
+
+    async def output_guard(
+        context: RunContextWrapper[Any], agent: Agent[Any], output: Any
+    ) -> GuardrailFunctionOutput:
+        output_checks.append(output)
+        raise AssertionError("There is no final answer to validate")
+
+    hooks = EndHooks()
+    session = SimpleListSession()
+    agent = Agent(
+        name="empty-stop",
+        model=model,
+        output_type=Answer if structured else None,
+        output_guardrails=[OutputGuardrail(output_guard)],
+    )
+    config = RunConfig(complete_on_empty_stop=True)
+    if streaming:
+        result = Runner.run_streamed(
+            agent, "input", run_config=config, hooks=hooks, session=session
+        )
+        assert result.is_complete is False
+        async for _ in result.stream_events():
+            pass
+        assert result.is_complete is True
+    else:
+        result = await Runner.run(agent, "input", run_config=config, hooks=hooks, session=session)
+    assert result.final_output is None
+    assert result.completion_reason == "completed_without_output"
+    assert result.new_items == []
+    assert len(model.calls) == 1
+    assert result.raw_responses[0].empty_output_stop_reason == "stop"
+    assert hooks.outputs == [None]
+    assert output_checks == []
+    assert result.output_guardrail_results == []
+    assert all(item.get("role") != "assistant" for item in await session.get_items())
+    with pytest.raises(UserError, match="terminal and cannot be resumed"):
+        result.to_state()
+    terminal_spans = [
+        span.export()
+        for span in fetch_ordered_spans()
+        if getattr(span.span_data, "name", None) == "completed_without_output"
+    ]
+    assert len(terminal_spans) == 1
+    assert terminal_spans[0] is not None
+    assert terminal_spans[0]["span_data"]["data"] == {"provider_finish_reason": "stop"}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("enabled,metadata", [(False, "stop"), (True, None)])
+async def test_default_recovery_and_missing_metadata_unchanged(
+    streaming: bool, enabled: bool, metadata: Any
+) -> None:
+    model = ScriptedModel(
+        [
+            ModelStep(output=[], empty_output_stop_reason=metadata),
+            [get_text_message('{"value":"ok"}')],
+        ]
+    )
+    agent = Agent(name="recovery", model=model, output_type=Answer)
+    config = RunConfig(complete_on_empty_stop=enabled)
+    if streaming:
+        result = Runner.run_streamed(agent, "input", run_config=config)
+        async for _ in result.stream_events():
+            pass
+    else:
+        result = await Runner.run(agent, "input", run_config=config)
+    assert result.final_output == Answer(value="ok")
+    assert result.completion_reason is None
+    assert len(model.calls) == 2
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("streaming", [False, True])
+async def test_input_guardrail_still_blocks(streaming: bool) -> None:
+    async def reject(
+        context: RunContextWrapper[Any], agent: Agent[Any], input: Any
+    ) -> GuardrailFunctionOutput:
+        return GuardrailFunctionOutput(output_info=None, tripwire_triggered=True)
+
+    model = ScriptedModel([ModelStep(output=[], empty_output_stop_reason="stop")])
+    agent = Agent(
+        name="guarded",
+        model=model,
+        input_guardrails=[InputGuardrail(reject, run_in_parallel=False)],
+    )
+    with pytest.raises(InputGuardrailTripwireTriggered):
+        if streaming:
+            result = Runner.run_streamed(
+                agent, "input", run_config=RunConfig(complete_on_empty_stop=True)
+            )
+            async for _ in result.stream_events():
+                pass
+        else:
+            await Runner.run(agent, "input", run_config=RunConfig(complete_on_empty_stop=True))
+    assert len(model.calls) == 0
+
+
+def test_sync_empty_stop() -> None:
+    model = ScriptedModel([ModelStep(output=[], empty_output_stop_reason="stop")])
+    result = Runner.run_sync(
+        Agent(name="sync", model=model, output_type=Answer),
+        "input",
+        run_config=RunConfig(complete_on_empty_stop=True),
+    )
+    assert result.final_output is None
+    assert result.completion_reason == "completed_without_output"
+    assert len(model.calls) == 1
