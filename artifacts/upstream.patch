@@ -0,0 +1,243 @@
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+from openai import AsyncOpenAI
+from openai.types.chat import ChatCompletion, ChatCompletionChunk
+from openai.types.chat.chat_completion import Choice
+from openai.types.responses import ResponseCompletedEvent
+
+from agents import ModelResponse, ModelSettings, ModelTracing, OpenAIChatCompletionsModel
+from agents.exceptions import ModelBehaviorError
+from agents.testing import ModelStep, ScriptedModel
+from agents.usage import Usage
+
+pytestmark = [pytest.mark.asyncio, pytest.mark.allow_call_model_methods]
+
+
+def _arguments() -> dict[str, Any]:
+    return {
+        "system_instructions": None,
+        "input": "synthetic input",
+        "model_settings": ModelSettings(),
+        "tools": [],
+        "output_schema": None,
+        "handoffs": [],
+        "tracing": ModelTracing.DISABLED,
+        "previous_response_id": None,
+        "conversation_id": None,
+        "prompt": None,
+    }
+
+
+def _completion(message: dict[str, Any], finish_reason: str = "stop") -> ChatCompletion:
+    return ChatCompletion(
+        id="synthetic-completion",
+        created=0,
+        model="synthetic-model",
+        object="chat.completion",
+        choices=[
+            Choice.model_validate(
+                {
+                    "index": 0,
+                    "finish_reason": finish_reason,
+                    "message": {"role": "assistant", **message},
+                }
+            )
+        ],
+    )
+
+
+@pytest.mark.parametrize(
+    ("message", "finish_reason", "expected"),
+    [
+        ({"content": ""}, "stop", "stop"),
+        ({"content": None}, "stop", None),
+        ({}, "stop", None),
+        ({"content": " "}, "stop", None),
+        ({"content": "\u200b"}, "stop", None),
+        ({"content": "answer"}, "stop", None),
+        ({"content": "", "refusal": "Cannot comply."}, "stop", None),
+        ({"content": ""}, "content_filter", None),
+        (
+            {
+                "content": "",
+                "tool_calls": [
+                    {
+                        "id": "call-test",
+                        "type": "function",
+                        "function": {"name": "synthetic_tool", "arguments": "{}"},
+                    }
+                ],
+            },
+            "tool_calls",
+            None,
+        ),
+        (
+            {
+                "content": "",
+                "function_call": {"name": "synthetic_tool", "arguments": "{}"},
+            },
+            "stop",
+            None,
+        ),
+    ],
+)
+async def test_chat_adapter_requires_explicit_empty_normal_stop(
+    monkeypatch: pytest.MonkeyPatch,
+    message: dict[str, Any],
+    finish_reason: str,
+    expected: str | None,
+) -> None:
+    # Provider-wire conversion is the boundary under test, not a scripted model response.
+    async with AsyncOpenAI(api_key="synthetic-test-key") as client:
+        monkeypatch.setattr(
+            client.chat.completions,
+            "create",
+            AsyncMock(return_value=_completion(message, finish_reason)),
+        )
+        response = await OpenAIChatCompletionsModel("synthetic-model", client).get_response(
+            **_arguments()
+        )
+    assert response.empty_output_stop_reason == expected
+    if expected == "stop":
+        assert response.output == []
+        assert response.to_input_items() == []
+    assert response.usage.requests == 1
+
+
+async def test_empty_length_response_remains_an_error(monkeypatch: pytest.MonkeyPatch) -> None:
+    async with AsyncOpenAI(api_key="synthetic-test-key") as client:
+        monkeypatch.setattr(
+            client.chat.completions,
+            "create",
+            AsyncMock(return_value=_completion({"content": ""}, "length")),
+        )
+        with pytest.raises(ModelBehaviorError, match="finish_reason='length'"):
+            await OpenAIChatCompletionsModel("synthetic-model", client).get_response(**_arguments())
+
+
+async def test_multiple_choices_do_not_supply_terminal_empty_evidence(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    response = _completion({"content": ""})
+    response.choices.append(response.choices[0].model_copy(update={"index": 1}))
+    async with AsyncOpenAI(api_key="synthetic-test-key") as client:
+        monkeypatch.setattr(client.chat.completions, "create", AsyncMock(return_value=response))
+        result = await OpenAIChatCompletionsModel("synthetic-model", client).get_response(
+            **_arguments()
+        )
+    assert result.empty_output_stop_reason is None
+
+
+async def _chunks(
+    deltas: list[dict[str, Any]], finish_reason: str | None
+) -> AsyncIterator[ChatCompletionChunk]:
+    for delta in deltas:
+        yield ChatCompletionChunk.model_validate(
+            {
+                "id": "synthetic-stream",
+                "object": "chat.completion.chunk",
+                "created": 0,
+                "model": "synthetic-model",
+                "choices": [{"index": 0, "delta": delta, "finish_reason": None}],
+            }
+        )
+    if finish_reason is not None:
+        yield ChatCompletionChunk.model_validate(
+            {
+                "id": "synthetic-stream",
+                "object": "chat.completion.chunk",
+                "created": 0,
+                "model": "synthetic-model",
+                "choices": [{"index": 0, "delta": {}, "finish_reason": finish_reason}],
+            }
+        )
+
+
+@pytest.mark.parametrize("buffer_tool_calls", [False, True])
+@pytest.mark.parametrize(
+    ("deltas", "finish_reason", "expected"),
+    [
+        ([{"role": "assistant", "content": ""}], "stop", "stop"),
+        ([{"role": "assistant", "content": None}], "stop", None),
+        ([{"role": "assistant"}], "stop", None),
+        ([], "stop", None),
+        ([{"content": ""}], None, None),
+        ([{"content": ""}, {"content": " "}], "stop", None),
+        ([{"content": ""}, {"content": "answer"}], "stop", None),
+        ([{"content": ""}, {"refusal": "Cannot comply."}], "stop", None),
+        ([{"content": ""}], "content_filter", None),
+        (
+            [
+                {"content": ""},
+                {
